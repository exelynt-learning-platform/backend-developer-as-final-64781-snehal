# Copy this file to .env (or export these variables) before running the app.

# --- Server ---
SERVER_PORT=8080

# --- Database (MySQL) ---
DB_URL=jdbc:mysql://localhost:3306/booking_db?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root
DB_DRIVER=com.mysql.cj.jdbc.Driver

# --- Database (PostgreSQL example - use instead of the MySQL values above) ---
# DB_URL=jdbc:postgresql://localhost:5432/booking_db
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DRIVER=org.postgresql.Driver

# --- Hibernate ---
# Use "update" for local dev, "validate" or "none" for production with migrations.
DDL_AUTO=update
SHOW_SQL=false

# --- JWT ---
# Use a long, random string (32+ chars) in real deployments.
JWT_SECRET=change-this-super-secret-key-in-production-min-32-chars
JWT_EXPIRATION_MS=86400000
| `CORS_ALLOWED_ORIGINS`| Comma-separated allow-list of origins (no `*` in production) | `http://localhost:3000,http://localhost:5173,http://localhost:8080` |

# --- CORS ---
# Comma-separated allow-list of origins permitted to call this API. Do NOT use "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- Logging ---
LOG_LEVEL=INFO
